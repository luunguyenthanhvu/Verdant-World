{
	"name": "@mocgioi/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev --name init",
		"db:push": "prisma db push",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@colyseus/core": "^0.15.57",
		"@colyseus/schema": "^2.0.30",
		"@colyseus/ws-transport": "^0.15.0",
		"@mocgioi/game-config": "workspace:*",
		"@mocgioi/shared": "workspace:*",
		"@prisma/client": "^6.0.0",
		"colyseus": "^0.15.48",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.0",
		"prisma": "^6.0.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/cors": "^2.8.5",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
